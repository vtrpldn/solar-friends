              "kind": "service",
              "minimum": 12,
              "minutes": 60,
              "service": "food"
            },
            "description": "Maintain at least 12 accessible edible portions for one observed hour. Incoming orders, carried cargo and eggs needing cooking do not count.",
            "id": "goal-8d508106-f8cd-4075-82ae-9f6fd4428cf4",
            "optional": false,
            "title": "Food people can reach"
